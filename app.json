{
  "configVersion": "v3",
  "app": {
    "appId": 20001,
    "appName": "Cadê o Busão",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "cade-o-bus",
    "description": "Mostra os ônibus de BH (BHTrans) mais próximos do seu ponto favorito."
  },
  "permissions": [
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/diag/index.page",
            "page/home/index.page",
            "page/detail/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "pt-BR": {
      "appName": "Cadê o Busão"
    },
    "en-US": {
      "appName": "Cade o Busao"
    }
  },
  "defaultLanguage": "pt-BR"
}
